# Copied to the server as /opt/saigonquest/.env by deploy/server.sh.
# Copy this file to .env.prod and fill in real values. Do not commit .env.prod.

ARANGO_HOST=127.0.0.1
ARANGO_PORT=8529
ARANGO_USER=saigonquest
ARANGO_PASSWORD=change-me
ARANGO_DATABASE=saigonquest

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_SEGMENT_MODEL=image-instance-segmentation
QWEN_SEGMENT_BASE_URL=https://dashscope.aliyuncs.com
QWEN_WORKSPACE_ID=

PORT=8080
BIND_HOST=127.0.0.1
UPLOAD_DIR=/opt/saigonquest/uploads
COOKIE_SECURE=true
TRUST_PROXY=true
COOKIE_SAMESITE=Lax
# Include the public web origin so browsers may call the API directly.
CORS_ALLOWED_HOSTS=https://town.example.com,localhost:3000,127.0.0.1:3000
