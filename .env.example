ARANGO_HOST=127.0.0.1
ARANGO_PORT=8529
ARANGO_USER=saigonquest
ARANGO_PASSWORD=saigonquest
ARANGO_DATABASE=saigonquest

# Model Studio key. DASHSCOPE_API_KEY is accepted as an alias.
QWEN_API_KEY=
# Host only. Do not append /compatible-mode/v1 — image calls are built from this root.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_IMAGE_MODEL=qwen-image-3.0
# Fun-Music is currently Beijing-only. Same API key as avatars.
QWEN_MUSIC_MODEL=fun-music-v1
# Optional workspace host, for example llm-xxxx. Leave blank to use the classic host.
QWEN_WORKSPACE_ID=
UPLOAD_DIR=uploads
COOKIE_SECURE=false
TRUST_PROXY=false
# PORT=8080
# BIND_HOST=0.0.0.0
# Comma-separated origins (https://town.example.com) or host:port (localhost:3000).
# CORS_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# COOKIE_SAMESITE=Lax
# Places API (New) + Maps JavaScript API.
# Allow these HTTP referrers on the key so Maps works on webpack:
#   http://localhost:3000/*
#   http://127.0.0.1:3000/*
# GOOGLE_MAPS_API_KEY=
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys --json
# Local Chrome allows push on http://localhost:3000 without HTTPS.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@saigon.town
