# Copy to deploy/web.env. That file is gitignored.

SSH_HOST=town.example.com
SSH_USER=root
SSH_PORT=22
# SSH_KEY=~/.ssh/id_ed25519

WEB_DOMAIN=town.example.com
SERVER_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# proxy: nginx serves the site and proxies /api and /media to the server.
# direct: the browser calls https://SERVER_DOMAIN. Requires API_MODE=direct on the server too.
API_MODE=proxy
# SERVER_UPSTREAM=https://api.example.com
# WEB_ROOT=/var/www/saigonquest
# NGINX_BIND=127.0.0.1:8081
# TRAEFIK_VERSION=v3.7.13
# TRAEFIK_DYNAMIC_DIR=/etc/traefik/dynamic
