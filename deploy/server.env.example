# Copy to deploy/server.env. That file is gitignored.
# App runtime values live in .env.prod, not here.

SSH_HOST=api.example.com
SSH_USER=root
SSH_PORT=22
# SSH_KEY=~/.ssh/id_ed25519

SERVER_DOMAIN=api.example.com
WEB_DOMAIN=town.example.com
ACME_EMAIL=you@example.com
ARANGO_ROOT_PASSWORD=change-me

# proxy matches the web default. direct also sets COOKIE_SAMESITE=None when that key is absent.
API_MODE=proxy
# APP_PORT=8080
# API_NGINX_BIND=127.0.0.1:8088
# TRAEFIK_VERSION=v3.7.13
# TRAEFIK_DYNAMIC_DIR=/etc/traefik/dynamic
